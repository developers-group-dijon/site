{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/garde-git.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
